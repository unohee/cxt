[
  {
    "id": "ts-import",
    "language": "typescript",
    "files": {
      "lib.ts": "export function run() {}",
      "other.ts": "export function run() {}",
      "main.ts": "import {run as go} from './lib.js';\nfunction caller() {\n  go();\n}"
    },
    "expected": [
      [
        "main.ts",
        3,
        3,
        "lib.ts::run"
      ]
    ]
  },
  {
    "id": "ts-reexport",
    "language": "typescript",
    "files": {
      "lib.ts": "export function run() {}",
      "barrel.ts": "export {run as execute} from './lib';",
      "main.ts": "import {execute} from './barrel';\nfunction caller() {\n  execute();\n}"
    },
    "expected": [
      [
        "main.ts",
        3,
        3,
        "lib.ts::run"
      ]
    ]
  },
  {
    "id": "ts-star-cycle",
    "language": "typescript",
    "files": {
      "a.ts": "export * from './b';\nexport function run() {}",
      "b.ts": "export * from './a';",
      "main.ts": "import {run} from './b';\nfunction caller() {\n  run();\n}"
    },
    "expected": [
      [
        "main.ts",
        3,
        3,
        "a.ts::run"
      ]
    ]
  },
  {
    "id": "ts-default-namespace",
    "language": "typescript",
    "files": {
      "lib.ts": "export default class Worker { run() {} }\nexport function helper() {}",
      "main.ts": "import Worker, * as lib from './lib';\nfunction caller() {\n  const w = new Worker();\n  w.run();\n  lib.helper();\n}"
    },
    "expected": [
      [
        "main.ts",
        3,
        13,
        "lib.ts::Worker"
      ],
      [
        "main.ts",
        4,
        3,
        "lib.ts::Worker.run"
      ],
      [
        "main.ts",
        5,
        3,
        "lib.ts::helper"
      ]
    ]
  },
  {
    "id": "ts-shadow",
    "language": "typescript",
    "files": {
      "lib.ts": "export function run() {}",
      "main.ts": "import {run} from './lib';\nfunction caller(run: () => void) {\n  run();\n}\nfunction other() {\n  run();\n}"
    },
    "expected": [
      [
        "main.ts",
        3,
        3,
        null
      ],
      [
        "main.ts",
        6,
        3,
        "lib.ts::run"
      ]
    ]
  },
  {
    "id": "ts-unbound",
    "language": "typescript",
    "files": {
      "lib.ts": "export function run() {}",
      "main.ts": "function caller() {\n  run();\n}"
    },
    "expected": [
      [
        "main.ts",
        2,
        3,
        null
      ]
    ]
  },
  {
    "id": "ts-alias-recursion",
    "language": "typescript",
    "files": {
      "main.ts": "function run() {\n  run();\n}\nfunction caller() {\n  const alias = run;\n  alias();\n}"
    },
    "expected": [
      [
        "main.ts",
        2,
        3,
        "main.ts::run"
      ],
      [
        "main.ts",
        6,
        3,
        "main.ts::run"
      ]
    ]
  },
  {
    "id": "ts-reassignment",
    "language": "typescript",
