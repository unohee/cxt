{
  "name": "@intrect/cxt",
  "version": "0.3.0",
  "description": "Code context toolkit — entity registry, BS detector, and AI context injection",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cxt": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-frontend-queries.mjs",
    "dev": "node --import=tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:bench-harness": "node --test testing/cxt_bench_codex.test.mjs",
    "bench:codex": "node testing/cxt_bench_codex.mjs",
    "test:watch": "vitest",
    "bench:accuracy": "node --import=tsx bench/accuracy.ts",
    "bench:calls": "node --import=tsx bench/call-accuracy.ts",
    "bench:cfg": "node --import=tsx bench/cfg-accuracy.ts",
    "bench:flow": "node --import=tsx bench/dataflow-accuracy.ts",
    "bench:impact": "node --import=tsx bench/impact-accuracy.ts",
    "test:package": "npm run build && node scripts/test-packed-frontends.mjs",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "commander": "^12.1.0",
    "nanoid": "^5.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "tree-sitter": "0.25.1",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0"
  },
  "overrides": {
    "tree-sitter": "$tree-sitter"
  }
}
